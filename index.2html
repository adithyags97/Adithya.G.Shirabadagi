<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Adithya G. Shirabadagi — Portfolio</title>
<meta name="description" content="Portfolio of Adithya G. Shirabadagi">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0a;--ink:#f4f1ea;--y:#f5e100;--red:#e5262a;--ivory:#eae8e2;--mut:#8d8a83;
--disp:'Anton','Impact','Arial Narrow',sans-serif;--sans:'Space Grotesk',system-ui,sans-serif;--serif:'Instrument Serif',Georgia,serif;--mono:'JetBrains Mono',ui-monospace,monospace}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
::selection{background:var(--y);color:#000}
.mono{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}
.wrap{padding:0 clamp(18px,4vw,56px)}
/* progress + cursor */
#bar{position:fixed;top:0;left:0;height:3px;background:var(--y);width:0;z-index:100}
#dot{position:fixed;width:14px;height:14px;border-radius:50%;background:var(--y);mix-blend-mode:difference;pointer-events:none;z-index:99;transform:translate(-50%,-50%);transition:width .2s,height .2s}
#dot.big{width:54px;height:54px}
@media (hover:none){#dot{display:none}}
/* nav */
nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(18px,4vw,56px);mix-blend-mode:difference}
nav .logo{font-family:var(--disp);font-size:1.4rem;letter-spacing:.04em;color:#fff}
nav ul{display:flex;gap:clamp(12px,2.4vw,32px);list-style:none;color:#fff}
nav a:hover{text-decoration:underline;text-underline-offset:5px}
@media(max-width:700px){nav ul li:nth-child(n+4){display:none}}
/* reveal */
.rv{opacity:0;transform:translateY(40px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
.rv.in{opacity:1;transform:none}
/* hero */
#hero{position:relative;min-height:100vh;display:grid;align-items:end;padding:110px clamp(18px,4vw,56px) 56px;overflow:hidden;isolation:isolate}
.ghost{position:absolute;top:70px;left:-1vw;font-family:var(--disp);font-size:clamp(7rem,27vw,30rem);line-height:.9;color:transparent;-webkit-text-stroke:2px #2c2c2c;white-space:nowrap;z-index:-2;user-select:none;will-change:transform}
.ybox{position:absolute;right:clamp(18px,6vw,110px);top:14vh;width:min(34vw,470px);aspect-ratio:3/4;background:var(--y);z-index:-1;transform:translate(24px,24px)}
.portrait{position:absolute;right:clamp(18px,6vw,110px);top:14vh;width:min(34vw,470px);aspect-ratio:3/4;z-index:0;overflow:hidden;background:#111}
.portrait img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;filter:contrast(1.05) saturate(1.05);transition:transform 1.2s}
.portrait:hover img{transform:scale(1.05)}
.tag{position:absolute;right:calc(clamp(18px,6vw,110px) + min(34vw,470px) - 30px);top:calc(14vh + 40px);background:var(--y);color:#000;padding:8px 14px;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;transform:rotate(-6deg);z-index:2;font-weight:700;white-space:nowrap}
.badge{position:absolute;left:clamp(18px,4vw,56px);top:30vh;width:92px;height:92px;border:2px solid var(--red);border-radius:50%;display:grid;place-items:center;text-align:center;font-family:var(--mono);font-size:.62rem;color:var(--ink);text-transform:uppercase;letter-spacing:.08em;line-height:1.3;transform:rotate(-12deg);animation:wob 6s ease-in-out infinite}
@keyframes wob{50%{transform:rotate(6deg) scale(1.06)}}
.hero-name{font-family:var(--disp);font-size:clamp(4rem,15.5vw,17rem);line-height:.88;text-transform:uppercase;letter-spacing:-.01em;position:relative;z-index:1;margin-top:40vh}
.hero-name span{display:block}
.hero-name .l2{font-size:.56em;color:var(--y);margin-top:.06em}
.hero-sub{margin-top:28px;display:flex;flex-wrap:wrap;gap:20px 56px;justify-content:space-between;align-items:flex-end;border-top:2px solid var(--ink);padding-top:20px;max-width:1200px;position:relative;z-index:1}
.hero-sub p{font-family:var(--serif);font-size:clamp(1.3rem,2.4vw,2rem);max-width:520px;line-height:1.15}
.hero-sub .cta{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;padding:14px 26px;border-radius:99px;border:1.5px solid var(--ink);font-family:var(--mono);font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;transition:.25s}
.btn.f{background:var(--y);border-color:var(--y);color:#000;font-weight:700}
.btn:hover{background:var(--ink);color:#000;transform:translateY(-3px)}
@media(max-width:820px){
 .portrait,.ybox{width:62vw;top:12vh;right:4vw}.ybox{transform:translate(14px,14px)}
 .tag{right:auto;left:4vw;top:calc(12vh + 52vw)}.badge{display:none}.hero-name{margin-top:48vh}}
/* marquee */
.mq{background:var(--y);color:#000;overflow:hidden;white-space:nowrap;padding:14px 0;border-block:2px solid #000;transform:rotate(-1.2deg);margin:30px -2vw}
.mq div{display:inline-block;animation:mq 28s linear infinite;font-family:var(--disp);font-size:clamp(1.4rem,3vw,2.4rem);letter-spacing:.04em;text-transform:uppercase}
.mq span{margin:0 22px}
@keyframes mq{to{transform:translateX(-50%)}}
/* sections */
section{padding:clamp(70px,11vw,150px) clamp(18px,4vw,56px)}
.sh{display:flex;align-items:baseline;gap:18px;margin-bottom:clamp(30px,5vw,70px)}
.sh .n{font-family:var(--mono);color:var(--y);font-size:.8rem}
.sh h2{font-family:var(--disp);font-size:clamp(3rem,10vw,9rem);line-height:.9;text-transform:uppercase}
.sh h2 em{font-family:var(--serif);font-style:italic;text-transform:none;color:var(--y);font-weight:400}
/* about */
.about{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(24px,5vw,80px);align-items:start}
.about .ph{background:var(--y);padding:14px;position:sticky;top:90px}
.about .ph img{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:50% 20%;filter:grayscale(1) contrast(1.1);mix-blend-mode:multiply;transition:filter .6s}
.about .ph:hover img{filter:none;mix-blend-mode:normal}
.about p.lead{font-family:var(--serif);font-size:clamp(1.6rem,3.2vw,2.8rem);line-height:1.12;margin-bottom:34px}
.about p.lead b{color:var(--y);font-weight:400;font-style:italic}
.facts{display:grid;grid-template-columns:130px 1fr;border-top:1px solid #333}
.facts>*{padding:14px 0;border-bottom:1px solid #333}
.facts dt{color:var(--mut)}
.facts dd{font-size:1.02rem}
@media(max-width:820px){.about{grid-template-columns:1fr}.about .ph{position:static;max-width:420px}}
/* skills */
.sk{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px;background:#222;border:2px solid #222}
.sk .c{background:var(--bg);padding:28px;transition:.3s}
.sk .c:hover{background:var(--y);color:#000}
.sk h3{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px;color:var(--mut)}
.sk .c:hover h3{color:#000}
.sk ul{list-style:none;display:flex;flex-wrap:wrap;gap:8px}
.sk li{border:1px solid currentColor;border-radius:99px;padding:6px 14px;font-size:.9rem}
/* projects */
.pr{border-top:2px solid var(--ink)}
.pj{display:grid;grid-template-columns:70px 1fr auto;gap:20px;align-items:center;padding:30px 0;border-bottom:1px solid #333;position:relative;transition:padding .4s,background .4s,color .4s}
.pj:hover{background:var(--y);color:#000;padding-left:20px;padding-right:20px}
.pj .i{font-family:var(--mono);font-size:.8rem}
.pj h3{font-family:var(--disp);font-size:clamp(1.8rem,5vw,4.2rem);text-transform:uppercase;line-height:1}
.pj p{margin-top:8px;max-width:640px;color:var(--mut);font-size:.98rem}
.pj:hover p{color:#222}
.pj .st{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.pj .st span{font-family:var(--mono);font-size:.64rem;letter-spacing:.08em;text-transform:uppercase;border:1px solid currentColor;padding:3px 9px;border-radius:99px}
.pj .ar{font-size:2.4rem;transition:transform .4s}
.pj:hover .ar{transform:rotate(45deg)}
@media(max-width:600px){.pj{grid-template-columns:40px 1fr}.pj .ar{display:none}}
/* timeline */
.tl{display:grid;gap:0;border-left:2px solid var(--y);margin-left:6px}
.tl .it{padding:0 0 44px 32px;position:relative}
.tl .it::before{content:"";position:absolute;left:-9px;top:6px;width:16px;height:16px;background:var(--bg);border:2px solid var(--y);border-radius:50%}
.tl .it:hover::before{background:var(--y)}
.tl .when{color:var(--y)}
.tl h3{font-family:var(--disp);font-size:clamp(1.6rem,3.6vw,2.8rem);text-transform:uppercase;margin:6px 0}
.tl p{color:var(--mut);max-width:680px}
/* certs */
.ct{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2px}
.ct .c{background:var(--y);color:#000;padding:26px;min-height:150px;display:flex;flex-direction:column;justify-content:space-between;outline:2px solid #000;transition:.3s}
.ct .c:hover{background:#000;color:var(--y);outline-color:var(--y)}
.ct h3{font-family:var(--sans);font-weight:700;font-size:1.1rem;line-height:1.2}
/* hire */
#contact{background:var(--ivory);color:#0a0a0a;position:relative;overflow:hidden;min-height:100vh;display:grid;align-content:center}
#contact h2{font-family:var(--disp);font-size:clamp(3.4rem,13vw,13rem);line-height:.86;text-transform:uppercase;position:relative;z-index:2}
#contact h2 em{display:block;font-family:var(--serif);font-style:italic;text-transform:none;font-weight:400;font-size:.8em}
#stage{position:relative;height:clamp(260px,38vw,420px);margin-top:20px}
#stage svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
#pill{position:absolute;left:62%;top:50%;transform:translate(-50%,-50%);background:#0a0a0a;color:#fff;border:0;padding:20px 54px;border-radius:99px;font-family:var(--disp);font-size:clamp(1.4rem,3vw,2.4rem);letter-spacing:.06em;cursor:pointer;box-shadow:0 0 0 5px var(--ivory),0 0 0 7px var(--red);touch-action:none;user-select:none}
#pill small{display:block;font-family:var(--mono);font-size:.55rem;letter-spacing:.2em;color:#aaa;margin-top:4px}
.fl{position:absolute;font-family:var(--disp);text-transform:uppercase;font-size:clamp(1.2rem,3vw,2.4rem);animation:fl 5s ease-in-out infinite}
.fl:nth-of-type(1){left:48%;top:6%;animation-delay:-1s}.fl:nth-of-type(2){left:78%;top:2%;animation-delay:-2s}.fl:nth-of-type(3){left:84%;top:46%;animation-delay:-3s}.fl:nth-of-type(4){left:50%;top:84%;color:var(--red);animation-delay:-4s}.fl:nth-of-type(5){left:72%;top:80%;animation-delay:-.5s}
@keyframes fl{50%{transform:translateY(-12px) rotate(3deg)}}
.cl{display:flex;flex-wrap:wrap;gap:12px 36px;margin-top:30px;position:relative;z-index:2}
.cl a{border-bottom:2px solid #0a0a0a;padding-bottom:3px;font-family:var(--mono);font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}
.cl a:hover{background:var(--y)}
#ov{position:fixed;inset:0;background:rgba(10,10,10,.92);z-index:200;display:none;place-items:center;padding:20px}
#ov.on{display:grid}
#ov .bx{background:var(--ivory);color:#0a0a0a;max-width:560px;width:100%;padding:36px;border-radius:6px;position:relative}
#ov h3{font-family:var(--disp);font-size:2.6rem;text-transform:uppercase;line-height:1;margin-bottom:6px}
#ov input,#ov textarea{width:100%;margin-top:12px;padding:14px;border:1.5px solid #0a0a0a;background:transparent;font:inherit;border-radius:4px}
#ov .btn{margin-top:16px;cursor:pointer;background:#0a0a0a;color:#fff;border-color:#0a0a0a}
#ov .x{position:absolute;right:16px;top:12px;background:none;border:0;font-size:1.8rem;cursor:pointer}
footer{padding:22px clamp(18px,4vw,56px);display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;background:var(--ivory);color:#555;border-top:1px solid #ccc}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}
</style>
</head>
<body>
<div id="bar"></div><div id="dot"></div>

<nav class="mono">
  <a class="logo" href="#hero">A.G.S</a>
  <ul><li><a href="#about">About</a></li><li><a href="#skills">Skills</a></li><li><a href="#projects">Projects</a></li><li><a href="#journey">Journey</a></li><li><a href="#contact">Hire</a></li></ul>
</nav>

<header id="hero">
  <div class="ghost" id="ghost">ADITHYA</div>
  <div class="ybox"></div>
  <div class="portrait"><img src="data:image/jpeg;base64," alt="Adithya G. Shirabadagi"></div>
  <div class="tag" id="tag">● Open to opportunities</div>
  <div class="badge" id="badge">Open<br>to<br>work</div>
  <h1 class="hero-name"><span>Adithya</span><span class="l2">G. Shirabadagi</span></h1>
  <div class="hero-sub">
    <p id="tagline">Developer. Problem solver. Builder of things that work.</p>
    <div class="cta"><a class="btn f" href="#projects">See my work</a><a class="btn" href="#contact">Hire me</a></div>
  </div>
</header>

<div class="mq"><div id="mq1"></div></div>

<section id="about">
  <div class="sh rv"><span class="n">01</span><h2>About <em>me</em></h2></div>
  <div class="about">
    <div class="ph rv"><img src="data:image/jpeg;base64," alt="Adithya portrait"></div>
    <div>
      <p class="lead rv" id="lead"></p>
      <dl class="facts mono rv" id="facts"></dl>
    </div>
  </div>
</section>

<section id="skills">
  <div class="sh rv"><span class="n">02</span><h2>Tool<em>box</em></h2></div>
  <div class="sk rv" id="sk"></div>
</section>

<section id="projects">
  <div class="sh rv"><span class="n">03</span><h2>Selected <em>work</em></h2></div>
  <div class="pr rv" id="pr"></div>
</section>

<section id="journey">
  <div class="sh rv"><span class="n">04</span><h2>The <em>journey</em></h2></div>
  <div class="tl rv" id="tl"></div>
</section>

<section id="certs">
  <div class="sh rv"><span class="n">05</span><h2>Certi<em>fications</em></h2></div>
  <div class="ct rv" id="ct"></div>
</section>

<section id="contact">
  <h2 class="rv">Pull me into <em>your team.</em></h2>
  <div id="stage">
    <svg id="svg"><path id="str" d="" fill="none" stroke="#0a0a0a" stroke-width="2.4" stroke-linecap="round"/></svg>
    <span class="fl">Ship</span><span class="fl">Together</span><span class="fl">Let's</span><span class="fl">Talk</span><span class="fl">Build</span>
    <button id="pill" aria-label="Open contact form">HIRE ME<small>DRAG ME · OR CLICK</small></button>
  </div>
  <div class="cl" id="cl"></div>
</section>

<div id="ov" role="dialog" aria-modal="true">
  <div class="bx"><button class="x" id="cx" aria-label="Close">×</button>
    <h3>Let's talk.</h3><p class="mono" style="color:#666">Opens your email app</p>
    <input id="fn" placeholder="Your name"><input id="fe" placeholder="Your email"><textarea id="fm" rows="4" placeholder="What are we building?"></textarea>
    <button class="btn" id="fs">Send message</button>
  </div>
</div>
<footer class="mono"><span id="fcopy"></span><span>Designed &amp; built by Adithya</span></footer>

<script>
/* ============================================================
   EDIT YOUR DETAILS HERE — everything on the page comes from this object.
   Anything marked "EDIT" is a placeholder until you give me your real info.
   ============================================================ */
const DATA = {
  name: "Adithya G. Shirabadagi",
  tagline: "EDIT: one line about you, e.g. 'Full-stack developer. Clean code, fast shipping.'",
  about: "EDIT: two or three sentences about who you are, what you study or do, and what you are looking for.",
  facts: [
    ["Based in", "EDIT: city, state"],
    ["Education", "EDIT: degree, college, year"],
    ["Focus", "EDIT: your main field"],
    ["Email", "EDIT: your email"]
  ],
  marquee: ["EDIT skill 1","EDIT skill 2","EDIT skill 3","EDIT skill 4","EDIT skill 5"],
  skills: [
    {t:"Languages", items:["EDIT","EDIT"]},
    {t:"Frontend",  items:["EDIT","EDIT"]},
    {t:"Backend & Databases", items:["EDIT","EDIT"]},
    {t:"Tools",     items:["EDIT","EDIT"]}
  ],
  projects: [
    {name:"EDIT Project One", desc:"EDIT: what it does and the result.", stack:["EDIT","EDIT"], link:"#"},
    {name:"EDIT Project Two", desc:"EDIT: what it does and the result.", stack:["EDIT","EDIT"], link:"#"},
    {name:"EDIT Project Three", desc:"EDIT: what it does and the result.", stack:["EDIT","EDIT"], link:"#"}
  ],
  journey: [
    {when:"EDIT YEAR – YEAR", title:"EDIT Degree / Role", org:"EDIT College / Company", desc:"EDIT: short description."},
    {when:"EDIT YEAR – YEAR", title:"EDIT Previous step", org:"EDIT School / Company", desc:"EDIT: short description."}
  ],
  certs: [
    {title:"EDIT Certification name", by:"EDIT Issuer"},
    {title:"EDIT Certification name", by:"EDIT Issuer"}
  ],
  contact: [
    ["Email","mailto:EDIT@example.com"],
    ["LinkedIn","#"],
    ["GitHub","#"]
  ],
  email: "EDIT@example.com"
};
/* ============================================================ */

const $=s=>document.querySelector(s), esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
document.title=DATA.name+" — Portfolio";
$('#tagline').textContent=DATA.tagline;
$('#lead').textContent=DATA.about;
$('#facts').innerHTML=DATA.facts.map(f=>`<dt>${esc(f[0])}</dt><dd style="font-family:var(--sans);text-transform:none;letter-spacing:0">${esc(f[1])}</dd>`).join('');
const m=DATA.marquee.map(x=>`<span>${esc(x)}</span>★`).join('');
$('#mq1').innerHTML=m+m+m+m;
$('#sk').innerHTML=DATA.skills.map(s=>`<div class="c"><h3>${esc(s.t)}</h3><ul>${s.items.map(i=>`<li>${esc(i)}</li>`).join('')}</ul></div>`).join('');
$('#pr').innerHTML=DATA.projects.map((p,i)=>`<a class="pj" href="${esc(p.link)}" target="_blank" rel="noopener"><span class="i">0${i+1}</span><div><h3>${esc(p.name)}</h3><p>${esc(p.desc)}</p><div class="st">${p.stack.map(s=>`<span>${esc(s)}</span>`).join('')}</div></div><span class="ar">↗</span></a>`).join('');
$('#tl').innerHTML=DATA.journey.map(j=>`<div class="it"><div class="when mono">${esc(j.when)}</div><h3>${esc(j.title)}</h3><div class="mono" style="color:#bbb">${esc(j.org)}</div><p style="margin-top:10px">${esc(j.desc)}</p></div>`).join('');
$('#ct').innerHTML=DATA.certs.map(c=>`<div class="c"><h3>${esc(c.title)}</h3><span class="mono">${esc(c.by)}</span></div>`).join('');
$('#cl').innerHTML=DATA.contact.map(c=>`<a href="${esc(c[1])}" target="_blank" rel="noopener">${esc(c[0])} ↗</a>`).join('');
$('#fcopy').textContent="© "+new Date().getFullYear()+" "+DATA.name;

/* scroll reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

/* progress bar + ghost parallax */
addEventListener('scroll',()=>{
  const h=document.documentElement;
  $('#bar').style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%';
  $('#ghost').style.transform=`translateX(${-scrollY*.25}px)`;
},{passive:true});

/* custom cursor */
const dot=$('#dot');
addEventListener('mousemove',e=>{dot.style.left=e.clientX+'px';dot.style.top=e.clientY+'px'});
document.querySelectorAll('a,button,.pj,.c').forEach(el=>{el.addEventListener('mouseenter',()=>dot.classList.add('big'));el.addEventListener('mouseleave',()=>dot.classList.remove('big'))});

/* hero name scramble */
(function(){
  const els=document.querySelectorAll('.hero-name span'),ch='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  els.forEach((el,k)=>{const t=el.textContent;let f=0;
    setTimeout(()=>{const iv=setInterval(()=>{
      el.textContent=t.split('').map((c,i)=>c===' '||c==='.'?c:(i<f/2?c:ch[Math.random()*26|0])).join('');
      if(++f>t.length*2){el.textContent=t;clearInterval(iv)}},40)},300+k*350)});
})();

/* hire-me string pill: drag it, string follows */
(function(){
  const pill=$('#pill'),stage=$('#stage'),path=$('#str');
  let ax=0,ay=0,px=0,py=0,drag=false,moved=false,t=0;
  function layout(){const r=stage.getBoundingClientRect();ax=-10;ay=r.height*.55;if(!drag){px=r.width*.62;py=r.height*.5}draw()}
  function draw(){
    pill.style.left=px+'px';pill.style.top=py+'px';
    const sag=Math.min(60,Math.hypot(px-ax,py-ay)*.12);
    const sx=px-pill.offsetWidth/2;
    path.setAttribute('d',`M${ax},${ay} Q${(ax+sx)/2},${(ay+py)/2+sag} ${sx},${py}`);
  }
  function pos(e){const r=stage.getBoundingClientRect();px=Math.max(160,Math.min(r.width-110,e.clientX-r.left));py=Math.max(40,Math.min(r.height-40,e.clientY-r.top));draw()}
  pill.addEventListener('pointerdown',e=>{drag=true;moved=false;pill.setPointerCapture(e.pointerId)});
  pill.addEventListener('pointermove',e=>{if(drag){moved=true;pos(e)}});
  pill.addEventListener('pointerup',()=>{drag=false;
    if(!moved){$('#ov').classList.add('on')}
    else{const r=stage.getBoundingClientRect(),tx=r.width*.62,ty=r.height*.5,sx=px,sy=py,st=performance.now();
      (function back(n){const k=Math.min(1,(n-st)/700),e=1-Math.pow(1-k,3);px=sx+(tx-sx)*e;py=sy+(ty-sy)*e;draw();if(k<1)requestAnimationFrame(back)})(st)}});
  addEventListener('resize',layout);layout();
  if(!matchMedia('(prefers-reduced-motion:reduce)').matches)(function idle(){t+=.02;if(!drag){const r=stage.getBoundingClientRect();py=r.height*.5+Math.sin(t)*8;draw()}requestAnimationFrame(idle)})();
})();

/* contact overlay */
$('#cx').onclick=()=>$('#ov').classList.remove('on');
$('#ov').onclick=e=>{if(e.target.id==='ov')e.currentTarget.classList.remove('on')};
addEventListener('keydown',e=>{if(e.key==='Escape')$('#ov').classList.remove('on')});
$('#fs').onclick=()=>{
  const b=encodeURIComponent(`${$('#fm').value}\n\n— ${$('#fn').value} (${$('#fe').value})`);
  location.href=`mailto:${DATA.email}?subject=${encodeURIComponent('Hello '+DATA.name)}&body=${b}`;
};
</script>
</body>
</html>
